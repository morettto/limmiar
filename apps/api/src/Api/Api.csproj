<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebAuthn ceremony verification (S02-05), consumed by WebAuthnCeremonyVerifier. The
         package id is "Fido2"; the assembly/namespace it ships is Fido2NetLib (there is a
         separate, abandoned "Fido2NetLib" package id stuck on 1.0.0-alpha, which is NOT this).
         Kept after a Native AOT spike: `dotnet publish -c Release -p:PublishAot=true
         -p:TrimmerSingleWarn=false` reports zero IL warnings with its full call graph rooted,
         because 4.x parses CBOR/COSE directly and serializes through its own
         System.Text.Json source-generated contexts. Note it drags in NSec.Cryptography plus a
         NATIVE libsodium (for the Ed25519 algorithms this project never enables), which is
         copied next to the AOT binary; worth revisiting if the runtime image is ever
         audited for unused native surface. -->
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Pinned above the transitive 2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.8 pulls
         in, which has a known high-severity vulnerability (GHSA-v5pm-xwqc-g5wc, patched in
         2.7.5) that trips this repo's SCA gate (dependency-review-action, fail-on-severity:
         high). Staying on the 2.x line (not jumping to 3.x): Microsoft.AspNetCore.OpenApi
         10.0.8's XmlCommentGenerator source generator targets the 2.x IOpenApiMediaType
         shape and fails to compile against 3.x's read-only Example property. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.6" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  
</Project>
