{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:i18n": "eslint src",
    "test:eslint-rules": "node --test eslint-rules/*.test.js",
    "check:i18n-extract": "lingui extract",
    "check:i18n-complete": "lingui compile --strict",
    "build:i18n-pseudo": "lingui compile --config lingui.config.pseudo.ts",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright-ct.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental"
  },
  "dependencies": {
    "@limmiar/crypto": "workspace:*",
    "@limmiar/i18n": "workspace:*",
    "@limmiar/ui": "workspace:*",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@tanstack/react-router": "^1.170.18",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@pact-foundation/pact": "^17.0.1",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/web-worker": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-lingui": "^0.14.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "wrangler": "^4.118.0"
  }
}
