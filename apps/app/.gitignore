# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
*.local

# Stryker mutation testing (incremental baseline is cached via
# actions/cache in CI, not committed; html/json reports are build output)
.stryker-tmp
reports/mutation

# Playwright component testing (test-results/playwright-report already
# covered by the root .gitignore for e2e; this is CT's own dev-server cache)
playwright/.cache

# Lingui: only the .po source catalogs are committed. `lingui compile`
# output (messages.js) is a build artifact — @lingui/vite-plugin compiles
# .po on the fly for the real app build, this is only ever written by the
# CI gates (check:i18n-complete, build:i18n-pseudo) that run the CLI
# directly. pseudo-LOCALE has no .po at all (ADR-S00.5-06: CI-only, never
# committed, never shipped) so the whole directory is ignored.
src/locales/**/messages.js
src/locales/pseudo-LOCALE/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
