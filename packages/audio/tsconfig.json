{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    // ES2023 base + ES2024.SharedMemory only for `Atomics.waitAsync` (used
    // by ring-buffer.ts's wait/notify — no polling loop on the hot path).
    "lib": ["ES2023", "ESNext.Intl", "ES2024.SharedMemory"],
    "types": ["node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts", "stryker.config.mjs"]
}
